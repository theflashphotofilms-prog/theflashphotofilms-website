# Database Configuration (PostgreSQL) - Optional, used only if direct DB access is needed
DATABASE_URL="postgresql://username:password@localhost:5432/theflashphotofilms"

# Google Apps Script Configuration (for Google Sheets Integration) - Required for lead capture
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# Email Configuration (Gmail) - Required for notifications
EMAIL_USER="your-email@gmail.com"
EMAIL_APP_PASSWORD="your-app-password"

# Email Recipients - Required for routing notifications
CONTACT_EMAIL_RECIPIENT="theflashphotofilms@gmail.com"
BOOKING_EMAIL_RECIPIENT="theflashphotofilms@gmail.com"
DISCOUNT_EMAIL_RECIPIENT="theflashphotofilms@gmail.com"

# Site Configuration
NEXT_PUBLIC_SITE_URL="https://www.theflashphotofilms.com"

# Google Analytics (optional)
GA_MEASUREMENT_ID="G-XXXXXXXXXX"